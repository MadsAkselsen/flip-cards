{
  "name": "Swahili tenses (past, present, future)",
  "explanation": "Swahili verbs use tense prefixes to show when something happens. A helpful trick is the name \"na-ta-li\": na = present, ta = future, li = past. The full verb structure is: subject prefix + tense prefix + verb root. Example: ni + na + lala = ninalala (I am sleeping).",
  "cards": [
    {
      "en": "Present tense",
      "sw": "-na-",
      "explanation": "Used for actions happening now. Example: ninalala (I am sleeping)."
    },
    {
      "en": "Future tense",
      "sw": "-ta-",
      "explanation": "Used for actions in the future. Example: nitalala (I will sleep)."
    },
    {
      "en": "Past tense",
      "sw": "-li-",
      "explanation": "Used for actions in the past. Example: nililala (I slept)."
    },
    {
      "en": "I slept",
      "sw": "nililala",
      "explanation": "ni (I) + li (past) + lala (sleep)."
    },
    {
      "en": "I am sleeping",
      "sw": "ninalala",
      "explanation": "ni (I) + na (present) + lala (sleep)."
    },
    {
