    {
      "en": "me / I",
      "sw": "mimi -> ni",
      "explanation": "Mimi means \"me\" or \"I\". The matching verb prefix is ni-, as in ni + na + soma = ninasoma, \"I am reading\"."
    },
    {
      "en": "you (singular)",
      "sw": "wewe -> u",
      "explanation": "Wewe means \"you\" when speaking to one person. The matching verb prefix is u-, as in u + na + soma = unasoma, \"you are reading\"."
    },
    {
      "en": "he / she",
      "sw": "yeye -> a",
      "explanation": "Yeye means \"he\" or \"she\". The matching verb prefix is a-, as in a + na + soma = anasoma, \"he/she is reading\"."
    },
    {
      "en": "us / we",
      "sw": "sisi -> tu",
      "explanation": "Sisi means \"us\" or \"we\". The matching verb prefix is tu-, as in tu + na + soma = tunasoma, \"we are reading\"."
    },
    {
      "en": "you (plural)",
      "sw": "ninyi -> m",
      "explanation": "Ninyi means \"you\" when speaking to more than one person. The matching verb prefix is m-, as in m + na + soma = mnasoma, \"you all are reading\"."
    },
    {
      "en": "they",
      "sw": "wao -> wa",
      "explanation": "Wao means \"they\". The matching verb prefix is wa-, as in wa + na + soma = wanasoma, \"they are reading\"."
    },
    {
      "en": "Conjugation formula",
      "sw": "subject prefix + tense prefix + verb root",
      "explanation": "For many verb forms, build the verb from three pieces: who is acting, when it happens, and the action itself. Example: ni + na + soma = ninasoma, \"I am reading\"."
    },
    {
      "en": "Present tense pattern",
      "sw": "prefix + na + root",
      "explanation": "The tense prefix -na- marks present or ongoing action. Combine it with the subject prefix and root: a + na + soma = anasoma, \"he/she is reading\"."
    },
